{
  "buildCommand": "npm run build && node_modules/.bin/esbuild api/_source.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --external:pg-native",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/api(/.*)?$", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
