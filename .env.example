# Supabase Database — from Supabase Dashboard > Settings > Database
# Port 6543 = Transaction (pooler) — used for runtime queries
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Port 5432 = Session (direct) — used for migrations
MIGRATE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your_random_secret_here

# URL where your app is running (no trailing slash)
# Dev: http://localhost:5173
# Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:5173
